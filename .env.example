# ============================================
# SCHOOL MANAGEMENT PORTAL - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ============================================
# SUPABASE (Backend + Frontend)
# ============================================
# Find these in your Supabase Dashboard → Project Settings → API

# Your Supabase project URL (e.g., https://abcdefghijklm.supabase.co)
SUPABASE_URL=your_supabase_url_here

# Your Supabase anon/public key (safe to use in frontend)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (BACKEND ONLY - NEVER expose to frontend)
# WARNING: This key bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Your Supabase JWT secret (used to verify tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ============================================
# BACKEND SERVER
# ============================================

# Port for the backend API server
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# CORS origin(s) - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# FRONTEND
# ============================================

# Frontend development server port
VITE_PORT=5173

# Backend API URL (for frontend to call)
VITE_API_URL=http://localhost:4000/api

# Supabase URL and anon key (same as above, prefixed for Vite)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# DATABASE
# ============================================

# PostgreSQL connection string (if not using Supabase directly)
# DATABASE_URL=postgresql://user:password@localhost:5432/school_management

# ============================================
# OPTIONAL - RATE LIMITING
# ============================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=1000

# ============================================
# OPTIONAL - AUDIT LOGGING
# ============================================

# Enable/disable audit logging (true/false)
AUDIT_LOGGING_ENABLED=true

# ============================================
# BOOTSTRAP
# ============================================

# Initial Super Admin bootstrap passwords.
BOOTSTRAP_SUPER_ADMIN_1_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_2_PASSWORD=
